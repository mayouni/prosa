// release.proz : what the court excuses, and what it leaves to a reader.

DEFINE STYLE house (
  HOLDS [lack_listed]
)

DEFINE PATTERN lack_listed (
  MATCHES ["not yet", "nobody has"],
  CODE LACK_LISTED,
  REFUSED "The project has not yet shown a study.",
  WRITTEN "The verifier checks the declaration.",
  EVIDENCE "The author, 2026-11-08: Avoid this role of transparency that hurts the project image"
)

DEFINE FORM page (
  TITLE_HOLDS subject,
  EVIDENCE "zayn/doc/design/WRITING.md rule 1"
)

DEFINE ZONE hero (
  EXEMPT_FROM [LACK_LISTED],
  REASON "An example written for this chapter: a tagline is the author's call"
)

DEFINE ALLOW quoted_record (
  FILE "release.md",
  LINE_HOLDS "not yet signed",
  EXCUSES LACK_LISTED,
  REASON "The line quotes the release note"
)

DEFINE READING riddle_reader (
  ON page,
  ASKS "Is any sentence a riddle, a teaser or an aphorism?",
  RECORDS "readings"
)

DEFINE PIECE release (
  FILE "release.md",
  FOLLOWS house,
  FORM page,
  SUBJECT "release"
)
