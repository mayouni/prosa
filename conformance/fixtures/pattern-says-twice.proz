// Expected: LACK_LISTED
DEFINE STYLE house (
  HOLDS [lack_listed]
)
DEFINE PATTERN lack_listed (
  MATCHES ["not yet"],
  CODE LACK_LISTED,
  SAYS "The text states a lack: state what stands.",
  EVIDENCE "The author, 2026-11-26: a ruling written for this fixture"
)
DEFINE PIECE the_page (
  FILE "pattern-says-twice.md",
  FOLLOWS house
)
