decl_ALLOW ::= "DEFINE" sp "ALLOW" sp ident sp "AS" ws "(" ws (clause_ALLOW (ws "," ws clause_ALLOW)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_ALLOW ::= "FILE" sp string | "LINE_HOLDS" sp string | "EXCUSES" sp ident | "REASON" sp string
decl_READING ::= "DEFINE" sp "READING" sp ident sp "AS" ws "(" ws (clause_READING (ws "," ws clause_READING)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_READING ::= "ON" sp ident | "ASKS" sp string | "RECORDS" sp string | "EVIDENCE" sp string

ident ::= [a-z_] [a-z0-9_]*
string ::= "\"" [^"]* "\""
number ::= [0-9]+
namelist ::= "[" ws (ident (ws "," ws ident)* (ws ",")?)? ws "]"
stringlist ::= "[" ws (string (ws "," ws string)* (ws ",")?)? ws "]"
sp ::= [ \t]+
ws ::= ([ \t\r\n] | "--" [^\n]* "\n")*
