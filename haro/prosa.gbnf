# prosa.gbnf -- GENERATED by forge.haro from the prosa declaration (stzu v0.1).
# The Commons' lexical form (C6): -- comments, double-quoted strings, UPPER_SNAKE keywords,
# lower_snake identifiers, trailing commas. A clause given twice and a required seat
# absent are the court's to refuse; the decoder holds the shape.

root ::= ws decl (ws decl)* ws
decl ::= decl_STYLE | decl_TERM | decl_WORDLIST | decl_PATTERN | decl_PROFILE | decl_FORM | decl_ZONE | decl_PIECE | decl_ALLOW | decl_READING
decl_STYLE ::= "DEFINE" sp "STYLE" sp ident sp "AS" ws "(" ws (clause_STYLE (ws "," ws clause_STYLE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_STYLE ::= "HOLDS" sp (ident | ident | ident | ident) | "ADOPTS" sp namelist | "DECLINES" sp (ident | ident | ident | ident) | "LANGUAGES" sp namelist | "MEASURED_FROM" sp string
decl_TERM ::= "DEFINE" sp "TERM" sp ident sp "AS" ws "(" ws (clause_TERM (ws "," ws clause_TERM)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_TERM ::= "MEANS" sp string | "REFUSES" sp stringlist | "WRITES" sp string | "EVIDENCE" sp string | "CODE" sp ident | "SEVERITY" sp ident | "LANGUAGE" sp ident | "ON" sp namelist | "IN" sp namelist | "MENTIONS" sp ident | "KEEPS" sp stringlist | "SAYS" sp string
decl_WORDLIST ::= "DEFINE" sp "WORDLIST" sp ident sp "AS" ws "(" ws (clause_WORDLIST (ws "," ws clause_WORDLIST)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_WORDLIST ::= "REFUSES" sp stringlist | "AT_MOST" sp string | "EVIDENCE" sp string | "CODE" sp ident | "SEVERITY" sp ident | "LANGUAGE" sp ident | "ON" sp namelist | "IN" sp namelist | "MENTIONS" sp ident | "KEEPS" sp stringlist | "SAYS" sp string
decl_PATTERN ::= "DEFINE" sp "PATTERN" sp ident sp "AS" ws "(" ws (clause_PATTERN (ws "," ws clause_PATTERN)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_PATTERN ::= "MATCHES" sp stringlist | "AT" sp ident | "REFUSED" sp string | "WRITTEN" sp string | "AT_MOST" sp string | "EVIDENCE" sp string | "CODE" sp ident | "SEVERITY" sp ident | "LANGUAGE" sp ident | "ON" sp namelist | "IN" sp namelist | "MENTIONS" sp ident | "KEEPS" sp stringlist | "SAYS" sp string
decl_PROFILE ::= "DEFINE" sp "PROFILE" sp ident sp "AS" ws "(" ws (clause_PROFILE (ws "," ws clause_PROFILE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_PROFILE ::= "SENTENCE_MEDIAN" sp string | "SENTENCES_OVER" sp string | "SENTENCES_UNDER" sp string | "DASHES" sp string | "COLONS" sp string | "EXCLAMATIONS" sp string | "COLD_EXCLAMATIONS" sp string | "QUESTIONS" sp string | "ELLIPSES" sp string | "COLON_LEADS" sp string | "ONE_SENTENCE_PARAGRAPHS" sp string | "MIN_WORDS" sp number | "EVIDENCE" sp string | "CODE" sp ident | "SEVERITY" sp ident | "LANGUAGE" sp ident | "ON" sp namelist
decl_FORM ::= "DEFINE" sp "FORM" sp ident sp "AS" ws "(" ws (clause_FORM (ws "," ws clause_FORM)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_FORM ::= "EXTENDS" sp ident | "TITLE_WORDS" sp string | "TITLE_HOLDS" sp ident | "FIRST_SENTENCE_HOLDS" sp ident | "SAY_ONCE" sp string | "HEADINGS" sp stringlist | "HEADING_CASE" sp ident | "CLOSES_WITHOUT" sp stringlist | "HOLES_CLOSED_AT" sp namelist | "EVIDENCE" sp string
decl_ZONE ::= "DEFINE" sp "ZONE" sp ident sp "AS" ws "(" ws (clause_ZONE (ws "," ws clause_ZONE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_ZONE ::= "EXEMPT_FROM" sp namelist | "REASON" sp string
decl_PIECE ::= "DEFINE" sp "PIECE" sp ident sp "AS" ws "(" ws (clause_PIECE (ws "," ws clause_PIECE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
