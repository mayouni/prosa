// ayouni.proz : the house style of AYOUNI Press, declared from the AYOUNI Writing Framework v0.6.
// Each rule cites the section, the decision or the ruling it comes from. The measures are those of the Ring book.

USE "prosa:reader_rights"

DEFINE STYLE ayouni (
  LANGUAGES [en, fr],
  ADOPTS [reader_rights],
  HOLDS [crafter, programmer, forbidden_words, calques, intensifiers, hedges, superlatives, no_emoji, ring_voice, ring_presence,
         artisan, programmeur, mots_interdits, intensifs, attenuations, superlatifs],
  MEASURED_FROM "ayouni/books/ring-book"
)

// The public pages of the house add the affirmative rule to the book style.
DEFINE STYLE ayouni_public (
  ADOPTS [ayouni],
  HOLDS [lack_listed, manque_liste]
)

// ---------------------------------------------------------------- one thing, one word

DEFINE TERM crafter (
  MEANS "the person who builds software",
  REFUSES [maker, makers],
  KEEPS ["decision maker", "decision makers"],
  LANGUAGE en, MENTIONS skipped,
  EVIDENCE "ayouni/CLAUDE.md: crafter is the person, never maker; FRAMEWORK.md section 4"
)

DEFINE TERM programmer (
  MEANS "the person who writes programs",
  REFUSES [developer, developers],
  LANGUAGE en, MENTIONS skipped,
  EVIDENCE "FRAMEWORK.md section 4: developer for programmer is a forbidden word"
)

DEFINE WORDLIST forbidden_words (
  REFUSES [
    substrate,
    leverage WRITE "use",
    [utilize, utilise, utilizes, utilises, utilized, utilised] WRITE "use",
    ["best practice", "best practices"] WRITE "what worked",
    [stakeholder, stakeholders] WRITE "the people concerned, by name",
    "in order to" WRITE "to"
  ],
  LANGUAGE en, MENTIONS skipped,
  CODE FORBIDDEN_WORD, SEVERITY error,
  EVIDENCE "FRAMEWORK.md section 4, the AYOUNI forbidden words; checklists/noise.md"
)

// ---------------------------------------------------------------- the noise list

DEFINE WORDLIST calques (
  REFUSES [
    [a, the, this, that, whole, your, my, our, his, her] "hole" WRITE "whole",
    "hole" [program, book, chapter, file, code, list, thing, system, solution, point, story, world] WRITE "whole",
    "staff" WRITE "stuff",
    "witch" WRITE "which",
    "fellow" [me, the, this, these, those, him, her, them, along] WRITE "follow",
    [more, less, better, rather, other, bigger, smaller, higher, lower, greater, larger, longer, shorter, faster, slower, easier, harder, simpler, older, newer, cheaper, earlier, later] WITHIN 2 "then" WRITE "than",
    "quiet" [like, simple, basic, the, a, an, good, different, clear, easy, hard, long, short] WRITE "quite",
    "in the same time" WRITE "at the same time",
    ["from one hand", "from the other hand"] WRITE "on one hand",
    ["obey to", "obeys to"] WRITE "obey",
    [a, an] [useful, important, interesting, good, bad, new] "information" WRITE "a piece of information",
    "in plus of" WRITE "besides",
    "may be" [in, a, the, not, you, we, it, this, that, because, if, later, one, two, three, more, some, for] WRITE "maybe",
    "imbricated" WRITE "nested",
    "cash" [miss, misses, memory] WRITE "cache"
  ],
  KEEPS ["staff member", "staff members", "staff of the", "staff turnover"],
  LANGUAGE en,
  CODE CALQUE, SEVERITY error,
  EVIDENCE "FRAMEWORK.md section 4, calques and homophones; books/ring-book/style/STYLE-ANALYSIS.md section 3"
)

DEFINE WORDLIST intensifiers (
  REFUSES [very, really, simply, obviously, obvious, "dead simple", "as simple as that", "so easy", "pretty much",
           basically, literally, extremely, incredibly],
  AT_MOST 4 PER_THOUSAND,
  LANGUAGE en,
  CODE INTENSIFIER, SEVERITY warning,
  SAYS "The sentence stands without it.",
  EVIDENCE "FRAMEWORK.md section 4, intensifiers and reassurance; the Ring profile with room"
)

DEFINE WORDLIST hedges (
  REFUSES ["maybe, and probably", somehow, "kind of", "sort of", "a little bit", "more or less", "in a way", "I guess",
           "I think that", "it seems that", "probably, and"],
  LANGUAGE en,
  CODE HEDGE, SEVERITY warning,
  SAYS "State the claim at its true size.",
  EVIDENCE "FRAMEWORK.md section 4, stacked hedges; checklists/noise.md"
)

DEFINE WORDLIST superlatives (
  REFUSES ["one of the most", "for the first time", "first ever", "the first" WITHIN 2 "to", unprecedented, revolutionary,
           "game-changing", "game changing", "paradigm shift", "world-class", "world class", "state-of-the-art",
           "state of the art", "cutting-edge", "cutting edge", groundbreaking, "the best" WITHIN 2 [in, of] "the world",
           "never before"],
  AT_MOST 1 PER_THOUSAND,
  LANGUAGE en,
  CODE SUPERLATIVE, SEVERITY warning,
  SAYS "Show the fact that earns the claim.",
  EVIDENCE "FRAMEWORK.md section 4, superlatives and self-advertising"
)

DEFINE PATTERN no_emoji (
  MATCHES [EMOJI],
  IN [title, heading, lede, body, list, quote],
  CODE EMOJI_IN_TEXT, SEVERITY error,
  SAYS "An emoji stands in text a reader sees.",
  EVIDENCE "ayouni/CLAUDE.md: no emoji in anything a reader sees"
)

// ---------------------------------------------------------------- the affirmative rule of the public pages

DEFINE PATTERN lack_listed (
  MATCHES [
    "not yet",
    ["is not", "are not", "was not", "were not", "has not", "have not", "had not",
     "isn't", "aren't", "wasn't", "weren't", "hasn't", "haven't", "hadn't"] WITHIN 7 "yet",
    [nobody, "no one"] [has, had, have],
    "never" [been, run, measured, shown, tested, perceived],
    ["has not", "have not", "had not", "hasn't", "haven't", "hadn't"] [been, measured, shown, tested, run],
    ["Limit:", "Limits:"],
    ["not", "not been"] [measured, shown, tested, perceived],
    ["not run", "not been run"],
    [unmeasured, untested, unproven],
    "yet to",
    ["nothing runs", "nothing is measured"]
  ],
  KEEPS ["do not run", "to not run", "must not run", "should not run", "can not run", "will not run", "don't not run"],
  IN [title, heading, lede, body, list],
  LANGUAGE en,
  CODE LACK_LISTED, SEVERITY error,
  SAYS "The line lists a lack. State what the thing is and does, at its true size.",
  REFUSED "No instrument here checks the perception: this was not yet measured.",
  WRITTEN "The verifier checks the declaration.",
  EVIDENCE "HOUSE-21; AWF-14; the author, 2026-11-08: Avoid this role of transparency that hurts the project image"
)

DEFINE PATTERN manque_liste (
  MATCHES [
    "pas encore",
    "personne n'a",
    "jamais" ["été", "exécuté", "mesuré", "testé", "montré"],
    ["Limite :", "Limites :"],
    ["n'a", "n'ont"] [pas, jamais] "été",
    "non" ["mesuré", "testé", "démontré"]
  ],
  IN [title, heading, lede, body, list],
  LANGUAGE fr,
  CODE LACK_LISTED, SEVERITY error,
  SAYS "La ligne énumère un manque. Dites ce que la chose est et fait, à sa vraie taille.",
  REFUSED "Ce point n'a pas encore été mesuré.",
  WRITTEN "Le vérificateur contrôle la déclaration.",
  EVIDENCE "HOUSE-21; AWF-14; ayouni/tools/check_public.py, VOICE_PHRASES, the French list"
)

// ---------------------------------------------------------------- the measure of the voice

// The upper bounds are the house lint's strict thresholds: the Ring profile with room.
DEFINE PROFILE ring_voice (
  SENTENCES_OVER 40 AT_MOST 6 PER_HUNDRED,
  EXCLAMATIONS AT_MOST 4 PER_THOUSAND,
  DASHES AT_MOST 4 PER_THOUSAND,
  MIN_WORDS 1,
  CODE OFF_PROFILE, SEVERITY error,
  EVIDENCE "AWF-04, the colon is the book's mark and the dash is rare; Ring profile: 3.3 % long, 2.4 exclamations and 0.5 dashes per thousand words"
)

// The lower bounds ask for what makes the voice present. The room is proposed and awaits the author's ruling.
DEFINE PROFILE ring_presence (
  SENTENCE_MEDIAN 16 WITHIN 5,
  SENTENCES_UNDER 10 AT_LEAST 12 PER_HUNDRED,
  COLONS AT_LEAST 5 PER_THOUSAND,
  MIN_WORDS 600,
  CODE VOICE_ABSENT, SEVERITY warning,
  EVIDENCE "FRAMEWORK.md section 5: median 16 words, a quarter under 10, colons 15 per thousand; STYLE-ANALYSIS.md: the 2026 books are more disciplined and colder"
)

// ---------------------------------------------------------------- the forms

DEFINE FORM chapter (
  HEADING_CASE sentence,
  CLOSES_WITHOUT ["summary", "conclusion", "in summary", "to sum up", "in conclusion", "to summarize", "to conclude"],
  HOLES_CLOSED_AT [review, published],
  EVIDENCE "FRAMEWORK.md C4 and C9: a chapter closes on a bridge, a release, a homework or a coda, never on a summary"
)

DEFINE FORM titled_chapter (
  EXTENDS chapter,
  TITLE_WORDS AT_MOST 6,
  EVIDENCE "books/zayn-book/CLAUDE.md: a title is six words at most and names its subject"
)

DEFINE FORM page (
  EXTENDS governed_text,
  TITLE_WORDS AT_MOST 6,
  EVIDENCE "zayn/doc/design/WRITING.md rule 1, amended 2026-11-14 (ZAYN-SITE-RETHINK-01 ruling 3)"
)

DEFINE READING voice_reader (
  ON chapter,
  ASKS "Which three passages are most him, and which one is least him?",
  RECORDS "research/voice"
)

// ---------------------------------------------------------------- the French edition

DEFINE TERM artisan (
  MEANS "la personne qui construit le logiciel",
  WRITES "artisan du logiciel",
  REFUSES [fabricant, fabricants, "créateur", "créateurs"],
  LANGUAGE fr, MENTIONS skipped,
  EVIDENCE "books/softanza-book/FRENCH.md; writing-framework/tools/style_lint.py, the French list"
)

DEFINE TERM programmeur (
  MEANS "la personne qui écrit des programmes",
  REFUSES ["développeur", "développeurs"],
  LANGUAGE fr, MENTIONS skipped,
  EVIDENCE "books/softanza-book/FRENCH.md; writing-framework/tools/style_lint.py, the French list"
)

DEFINE WORDLIST mots_interdits (
  REFUSES [substrat, ["meilleure pratique", "meilleures pratiques", "meilleure pratiques", "meilleures pratique"] WRITE "ce qui a marché"],
  LANGUAGE fr, MENTIONS skipped,
  CODE FORBIDDEN_WORD, SEVERITY error,
  EVIDENCE "writing-framework/tools/style_lint.py, the French list"
)

DEFINE WORDLIST intensifs (
  REFUSES ["très", vraiment, simplement, "évidemment", "extrêmement", incroyablement, "littéralement"],
  AT_MOST 4 PER_THOUSAND,
  LANGUAGE fr,
  CODE INTENSIFIER, SEVERITY warning,
  SAYS "La phrase tient sans lui.",
  EVIDENCE "writing-framework/tools/style_lint.py, the French list"
)

DEFINE WORDLIST attenuations (
  REFUSES ["en quelque sorte", "plus ou moins", "d'une certaine manière", "un petit peu"],
  LANGUAGE fr,
  CODE HEDGE, SEVERITY warning,
  EVIDENCE "writing-framework/tools/style_lint.py, the French list"
)

DEFINE WORDLIST superlatifs (
  REFUSES ["pour la première fois dans l'histoire", "pour la première fois au monde", "pour la toute première fois dans l'histoire",
           "pour la toute première fois au monde", "sans précédent", "révolutionnaire", "l'un des plus", "l'une des plus",
           "de classe mondiale", "jamais vu"],
  AT_MOST 1 PER_THOUSAND,
  LANGUAGE fr,
  CODE SUPERLATIVE, SEVERITY warning,
  EVIDENCE "writing-framework/tools/style_lint.py, the French list"
)
